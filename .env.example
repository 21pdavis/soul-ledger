# Neon connection string (dev branch locally, main branch on Render). Never commit real values.
DATABASE_URL=postgresql://user:password@host/soul_ledger?sslmode=verify-full
# Staging only (ADR 0042). Production leaves STAGING_GATE unset.
# STAGING_GATE=on
# STAGING_ACCESS_KEY=<32+ random chars>   (ADR 0043)
# For agents testing live staging from this machine (same key):
# STAGING_URL=https://soul-ledger-staging.onrender.com
# STAGING_DATABASE_URL=<Neon staging branch connection string>

# Optional Steam Web API key (https://steamcommunity.com/dev/apikey). When set, vanity URLs resolve via
# the official API instead of the public profile XML, which can be rate-limited from server IPs.
STEAM_API_KEY=
